{
  "manifest_version": 3,
  "name": "Balloon Boy Walker",
  "version": "1.0",
  "description": "Balloon Boy randomly walks across your screen.",
  "permissions": ["scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["main.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["balloon-boy.gif"],
      "matches": ["<all_urls>"]
    }
  ]
}
